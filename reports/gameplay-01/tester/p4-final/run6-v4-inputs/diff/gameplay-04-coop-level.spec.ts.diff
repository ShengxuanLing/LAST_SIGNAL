+// input-consumption diagnostics (read-only): which stepFrame actually processed
+// the ticks, so a key edge can be judged by simulation progress, not by sleep.
+// ---------------------------------------------------------------------------
+
+/** Per-stepFrame trace: ticks processed, queue before/after, signal events emitted. */
+async function installStepTrace(page: Page): Promise<void> {
+  await page.evaluate(() => {
+    const w: any = (window as any).__game.scene.getScene('GameScene').world;
+    if ((w as any).__p4sfTap) return;
+    (window as any).__p4sf = [];
+    const orig = w.stepFrame.bind(w);
+    w.stepFrame = (dt: number, intent: any, echoIntent?: any) => {
+      const t0 = w.sim.tick;
+      const queueBefore = (w.sim.pendingCommands ?? []).map((c: any) => c.type);
+      const energyBefore = w.signalView?.()?.playerEnergy ?? null;
+      const ev = orig(dt, intent, echoIntent) ?? [];
+      const t1 = w.sim.tick;
+      (window as any).__p4sf.push({
+        t0, t1, ticks: t1 - t0, queueBefore,
+        queueAfter: (w.sim.pendingCommands ?? []).map((c: any) => c.type),
+        energyBefore, energyAfter: w.signalView?.()?.playerEnergy ?? null,
+        ev: ev.map((e: any) => `${e.type}${e.actorId !== undefined ? '#' + e.actorId : ''}`),
+        loopFrame: (window as any).__game?.loop?.frame ?? null
+      });
+      return ev;
+    };
+    (w as any).__p4sfTap = true;
+  });
+}
+
+/** Everything the core checks for a HUMAN jam, read from the real world state. */
+async function jamPreconditions(page: Page) {
+  return page.evaluate(() => {
+    const g: any = (window as any).__game;
+    const gs: any = g.scene.getScene('GameScene');
+    const w: any = gs?.world;
+    if (!w) return { ok: false, checks: { world: false } };
+    const sv: any = w.signalView?.() ?? null;
+    const sc: any = w.p1Scenario;
+    const relay = sc?.relay;
+    const dist = relay ? Math.hypot(w.player.wx - relay.x, w.player.wy - relay.y) : null;
+    // LOS exactly like the core: sample the segment at 0.25 with radius 0.5.
+    let los = false;
+    if (relay) {
+      const samples = Math.max(1, Math.ceil(dist! / 0.25));
+      los = true;
+      for (let i = 1; i <= samples; i += 1) {
+        const t = i / samples;
+        if (!w.isWalkable(w.player.wx + (relay.x - w.player.wx) * t, w.player.wy + (relay.y - w.player.wy) * t, 0.5)) { los = false; break; }
+      }
+    }
+    const activeScenes = g.scene.getScenes(true).map((s: any) => s.sys.settings.key);
+    const checks = {
+      gameSceneActive: g.scene.isActive('GameScene'),
+      onlyGameScene: activeScenes.length === 1 && activeScenes[0] === 'GameScene',
+      notPaused: gs.paused === false,
+      notLevelUp: gs.levelUpActive === false,
+      world: !!w,
+      camera: !!gs.cameras?.main,
+      relayActive: sv?.relay === 'ACTIVE',
+      jamCDzero: sv?.playerJamCD === 0,
+      energyEnough: (sv?.playerEnergy ?? 0) >= 25,
+      inRange: dist !== null && dist <= 6,
+      lineOfSight: los
+    };
+    return { ok: Object.values(checks).every(Boolean), checks, distance: dist, energy: sv?.playerEnergy ?? null, activeScenes };
+  });
+}
