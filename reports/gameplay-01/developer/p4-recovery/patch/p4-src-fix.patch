+  const a = targets[li];
+  const b = targets[(li + 1) % targets.length];
+  for (const target of [a, b]) {
+    if (!room.connectedTo.includes(target.id)) room.connectedTo.push(target.id);
+    if (!target.connectedTo.includes(room.id)) target.connectedTo.push(room.id);
+  }
