+function syntheticMap(size: number, kind: () => 'floor' | 'wall'): MapData {
+  const tiles: MapData['tiles'] = [];
+  for (let y = 0; y < size; y += 1) {
+    const row: MapData['tiles'][number] = [];
+    for (let x = 0; x < size; x += 1) row.push({ x, y, type: kind(), height: 0 });
+    tiles.push(row);
