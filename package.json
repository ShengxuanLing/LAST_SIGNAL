{
  "name": "last-signal",
  "version": "0.1.0",
  "description": "LAST SIGNAL \u2014 a 2.5D isometric sci-fi roguelite browser game",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright": "playwright test",
    "game:headless": "vite-node src/ai-native/headlessCli.ts --run --dev",
    "game:mcp:build": "vite build --config vite.mcp.config.ts",
    "game:mcp": "vite-node src/ai-native/mcpServer.ts --dev",
    "game:mcp:client": "vite-node src/ai-native/mcpClient.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "phaser": "^3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.19.43",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.2"
  }
}
