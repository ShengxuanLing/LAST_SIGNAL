{
  "name": "last-signal",
  "version": "0.1.0",
  "description": "LAST SIGNAL \u2014 a 2.5D isometric sci-fi roguelite browser game",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright": "playwright test",
    "game:headless": "vite-node src/ai-native/headlessCli.ts --run --dev",
    "game:mcp:build": "vite build --config vite.mcp.config.ts",
    "game:mcp": "vite-node src/ai-native/mcpServer.ts --dev",
    "game:mcp:client": "vite-node src/ai-native/mcpClient.mts",
    "game:agent-client": "vite-node src/ai-native/agentClient.mts",
    "game:replay-p4": "vite-node src/ai-native/replayPlayerTrace.mts",
    "game:coop-demo": "vite-node src/ai-native/coopDemo.mts",
    "game:budget-client": "vite-node src/ai-native/budgetClient.mts",
    "game:sim:parity": "vite-node scripts/c2-node-parity.ts",
    "build:test": "vite build --mode test --outDir dist-test",
    "game:world": "vite-node src/ai-native/mcpServer.ts --world",
    "game:world:bridge": "vite-node scripts/c3b-bridge.mts",
    "game:world:console": "vite-node scripts/c3b-world-console.mts",
    "game:world:mcp-console": "vite-node scripts/c3b-mcp-console.mts",
    "game:world:headless": "vite-node src/ai-native/worldHeadlessMcpServer.ts",
    "game:world:headless:dev": "vite-node src/ai-native/worldHeadlessMcpServer.ts --dev",
    "game:world:lease-smoke": "vite-node src/ai-native/worldMcpLeaseSmoke.mts",
    "game:world:smoke": "vite-node src/ai-native/worldMcpSmoke.mts",
    "game:world:integration": "vite-node src/ai-native/worldMcpIntegration.mts",
    "game:f03:gate": "vite-node scripts/c3b-f03-gate.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "phaser": "^3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.19.43",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.2"
  }
}
